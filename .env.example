# =============================================================================
# ENTORNO — copiá este archivo a .env (que está en .gitignore).
#
# Qué corre LOCAL:  Postgres + pgvector, el sidecar de reranking/NLI (:8790),
#                   whisper (STT) y piper (TTS).
# Qué sale a la RED: la generación del LLM y los EMBEDDINGS, contra una API
#                    compatible con OpenAI. Las dos cosas usan la misma key.
#
# ⚠️ SIN INTERNET NO HAY NADA. Antes se caía solo la generación y la búsqueda
# seguía andando (los embeddings eran locales); hoy los embeddings son remotos,
# así que un corte de red deja al alumno sin poder ni buscar en el material.
# =============================================================================

# === Base de datos local (Postgres NATIVO + pgvector, SIN Docker) ===
# Postgres.app o `brew install postgresql@17 pgvector` (§1.3: recupera 2-3 GB RAM)
DATABASE_URL=postgresql://localhost:5432/tutor

# =============================================================================
# PROVEEDOR REMOTO (LLM + embeddings)
# Hay UN solo proveedor. LLM_PROVIDER ya no hace falta: se sigue aceptando por
# compatibilidad, pero el único valor válido es "deepinfra". Si tu .env viejo
# dice LLM_PROVIDER=ollama, sacá esa línea — el motor local se eliminó del
# proyecto y arrancar así falla con un error que lo explica.
# =============================================================================

# OBLIGATORIA. Sin esta key no hay generación NI embeddings, o sea que tampoco
# hay búsqueda. Solo server-side, nunca en el bundle del cliente.
# NO la pongas en .claude/launch.json: ese archivo SÍ se commitea.
DEEPINFRA_API_KEY=
# (LLM_API_KEY sigue aceptándose como alias, por compatibilidad con .env viejos)

# Base URL del proveedor compatible con OpenAI. El MISMO modelo lo sirven
# varios; apuntar a otro es cambiar esta línea, sin tocar código.
#   DeepInfra  https://api.deepinfra.com/v1/openai        Qwen/Qwen3.6-35B-A3B
#   Scaleway   https://api.scaleway.ai/v1                 qwen/qwen3.6-35b-a3b:fp8
#   Novita     https://api.novita.ai/openai               qwen/qwen3.6-35b-a3b
#   Parasail   https://api.parasail.io/v1                 (listar con GET /v1/models)
#   GMI Cloud  https://api.gmi-serving.com/v1             Qwen/Qwen3.6-35B-A3B
#   Alibaba    https://dashscope-intl.aliyuncs.com/compatible-mode/v1  qwen3.6-35b-a3b
# OJO: el model ID NO es igual entre proveedores → ajustá también LLM_MODEL.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai

# ─────────── Razonamiento ("thinking") ───────────
# "off" (default) / "on". Medido en Qwen3.6: con thinking ON gastó 191 tokens
# de salida para 3 de respuesta útil (64x). Se manda SIEMPRE explícito.
LLM_REASONING=off
# Escape hatch: qué interruptores mandar (coma). Vacío = todos.
# Ningún parámetro sirve a todos los proveedores:
#   chat_template_kwargs -> vLLM/SGLang/DeepInfra/Parasail
#   reasoning_effort     -> DeepInfra, Scaleway
#   reasoning            -> DeepInfra
#   enable_thinking      -> Novita, Alibaba  (DeepInfra lo IGNORA)
# Acotalo solo si un proveedor estricto rechaza claves desconocidas con 400.
# LLM_REASONING_PARAMS=chat_template_kwargs,reasoning_effort

# === Modelo de lenguaje ===
# Vacío = el default del provider (Qwen/Qwen3.6-35B-A3B en DeepInfra).
# DEJALO COMENTADO salvo que sepas el ID exacto del proveedor que estás usando:
# un ID que no existe del otro lado devuelve 404 (misma trampa que había en
# .claude/launch.json, de donde LLM_MODEL se sacó justamente por esto).
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B

# --- Decodificación CONSERVADORA (anti-alucinaciones) ---
# Estos valores se mandan EXPLÍCITOS al proveedor. Si se dejaran implícitos, la
# API usaría SU default (temperature 1.0) contra el 0.1 nuestro: mismo prompt,
# respuestas distintas, y el golden set deja de ser reproducible sin que nada
# avise. (La regla nació cuando había dos motores con defaults distintos; con
# uno solo sigue valiendo — el default del proveedor puede cambiar cuando quiera.)
LLM_TEMPERATURE=0.1        # bajo = determinista, se ciñe al material
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048        # tope de salida por llamada (evita facturas sorpresa)
# LLM_SEED=42              # semilla best-effort; ayuda a reproducir corridas

# --- Timeouts y reintentos ---
# 60s NO alcanza: /api/test es UNA llamada structured de ~1400 tokens, medida
# entre 10s y 110s según cómo esté el proveedor. Con 60s se cortaba a mitad
# (y antes del fix se reintentaba como si fuera un fallo de red, pagando 3x).
LLM_TIMEOUT_MS=180000      # ≤ maxDuration de la ruta más larga (/api/test = 180)
LLM_JSON_TIMEOUT_MS=180000 # salida estructurada
# LLM_STREAM_TIMEOUT_MS=0  # 0 = sin timeout por chunk. El corte duro de punta a
#                          # punta lo hace LLM_STREAM_DEADLINE_MS (120s), que no
#                          # depende de que el proveedor honre el AbortSignal.
LLM_MAX_RETRIES=2          # solo en 429 y 5xx; nunca en otros 4xx

# --- Tope de gasto (importante al medir contra una API paga) ---
# Tokens acumulados por corrida; al superarlo, la próxima llamada aborta.
# 0 = sin límite. El golden set son 133 preguntas x 2 llamadas (+ reintentos).
LLM_MAX_TOKENS_PER_RUN=0

# LLM_LOG=0                # silencia el log por llamada (modelo/tokens/latencia)

# === Embeddings (REMOTOS, misma API y misma key) ===
# Vacío = se usa LLM_BASE_URL. Se separa por si algún día conviene servir los
# embeddings en otro lado que la generación.
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
# bge-m3 (multilingüe, 1024 dims). Los 28.986 chunks de la base se embebieron
# con este mismo modelo cuando corría local, y NO hubo que rehacerlos: se midió
# el mismo texto por los dos caminos y el coseno dio 0,999993 (norma 1,0000 en
# ambos). ⚠️ Eso vale para bge-m3 y para nadie más: cambiar este valor por otro
# modelo obliga a re-embeber el corpus entero (que coincida la dimensión NO
# alcanza, dos modelos de 1024 dims pueden vivir en espacios incompatibles).
EMBEDDING_MODEL=BAAI/bge-m3

# === RAG estricto ===
RAG_MIN_SIMILARITY=0.35    # (legacy: gate por coseno; el gate real usa el reranker)
RAG_ENABLE_VERIFIER=1      # verificador A3 (NLI por oración); 0 para apagarlo
RAG_FALSE_PREMISE_CHECK=1  # detecta y corrige premisas falsas antes de responder; 0 apaga

# === Encuadre del alcance (auditoría Fase 0, 2026-08-05) ===
# El gate del reranker mide RELEVANCIA, no si el fragmento CONTESTA: una ficha que
# nombra "Cien años de soledad" es máximamente relevante a una pregunta sobre esa
# novela y no responde nada. Este discriminador (NLI con la pregunta convertida en
# afirmación) gobierna SOLO las etapas cross-scope — el libro del propio curso
# nunca pasa por él, a propósito.
RAG_ANSWERABILITY=1            # 0 apaga el discriminador (y con él, `apoyado`)
RAG_ANSWERABILITY_MIN=         # vacío = 0.85. El 0.91 del sweep era in-sample: su
                               # pico vive en una rendija de 0,03. Ver answerability.ts
RAG_APOYADO=                   # 0 apaga el modo `apoyado` sin tocar el discriminador
RAG_APOYADO_MIN_RELEVANCIA=    # vacío = 0.80 — "¿es del tema?"
RAG_APOYADO_MIN_ENTAIL=        # vacío = 0.50 — "¿dice algo al respecto?". Las DOS
                               # hacen falta: q129 tiene relevancia 0,847 y entail
                               # 0,147 (habla de Euclides, no de Pitágoras).
RAG_PEDAGOGY_MIN_SCORE=        # vacío = 0.05. Sin gate entraban ~8 bloques de guía
                               # por turno, 6 de ellos ruido de score ~0.003.
CLOSING_QUESTION_CHECK=        # vacío = prendido. Valida que la pregunta de cierre
                               # no se responda copiando el propio mensaje.
TUTOR_FECHA=                   # vacío = hoy. Fija la fecha del prompt del modo
                               # general para que el eval compare el mismo prompt.

# === Reranker + NLI (gate de abstención + verificación, Fase 0.5/2) — LOCAL ===
# Requiere el servidor: packages/ingest-py/.venv/bin/python packages/ingest-py/rerank_server.py
# (sirve /rerank y /nli; el modelo NLI mDeBERTa se baja solo en el 1er /nli)
RERANK_BASE_URL=http://127.0.0.1:8790
# Umbral de abstención del reranker (0-1). CALIBRADO: plateau seguro 0.05-0.50.
# 0.18 = tutor FLEXIBLE (bajado de 0.3; ver config.ts). Este archivo decía 0.3,
# así que copiarlo revertía el gate en silencio.
RERANK_MIN_SCORE=0.18
# Umbrales del verificador NLI direccional (Fase 2, ver nli-validate).
NLI_MIN_ENTAIL=0.5         # entailment mínimo para dar una oración por respaldada
NLI_MIN_CONTRA=0.5         # contradiction mínima para marcarla como contradicha

# === Dev ===
# Usuario de desarrollo mientras no hay auth real (Fase 1)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# === Voz en tiempo real (Fase 3) — esto sí es local ===
# STT local: whisper.cpp / faster-whisper
# TTS local: piper
