# =============================================================================
# MODO LOCAL — todo corre en tu máquina. Nada se envía a la nube.
# =============================================================================

# === Base de datos local (Postgres NATIVO + pgvector, SIN Docker) ===
# Postgres.app o `brew install postgresql@17 pgvector` (§1.3: recupera 2-3 GB RAM)
DATABASE_URL=postgresql://localhost:5432/tutor

# === Modelos de lenguaje locales (Ollama), con routing por tarea ===
OLLAMA_BASE_URL=http://localhost:11434
# Tareas (examen, corrección, verificación): calidad importa, latencia no.
LLM_MODEL=qwen2.5:7b-instruct
# Voz (Fase 5): latencia baja. NO tener ambos cargados a la vez (keep_alive:0).
LLM_VOICE_MODEL=qwen2.5:3b-instruct

# --- Decodificación CONSERVADORA (anti-alucinaciones) ---
LLM_TEMPERATURE=0.1        # bajo = determinista, se ciñe al material
LLM_TOP_P=0.9
LLM_NUM_CTX=8192           # ventana de contexto en tokens

# === Embeddings locales (Ollama) ===
# Requiere:  ollama pull bge-m3   (multilingüe, 1024 dims)
EMBEDDING_MODEL=bge-m3

# === RAG estricto ===
RAG_MIN_SIMILARITY=0.35    # (legacy: gate por coseno; el gate real usa el reranker)
RAG_ENABLE_VERIFIER=0      # 1 para activar el verificador (capa 5)

# === Reranker (gate de abstención, Fase 0.5) ===
# Requiere el servidor: packages/ingest-py/.venv/bin/python packages/ingest-py/rerank_server.py
RERANK_BASE_URL=http://127.0.0.1:8790
# Umbral de abstención (0-1). CALIBRADO sobre golden set: plateau seguro 0.05-0.50.
RERANK_MIN_SCORE=0.3

# === Dev ===
# Usuario de desarrollo mientras no hay auth real (Fase 1)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# === Voz en tiempo real (Fase 3) — también local ===
# STT local: whisper.cpp / faster-whisper
# TTS local: piper
